# --- Konfigurasi Backend (VPS 1) ---
PORT=8080

# Format DATABASE_URL: postgres://USER:PASSWORD@IP_VPS_2:5432/DB_NAME?sslmode=disable
# Contoh jika VPS 2 IP-nya 192.168.1.100:
DATABASE_URL=postgres://postgres:yolnDA2623*KingRovs771@202.155.18.29:5432/mentalhealth?sslmode=disable

# Format REDIS_URL: redis://:PASSWORD@IP_VPS_2:6379/0
# Contoh jika VPS 2 IP-nya 192.168.1.100:
REDIS_URL=redis://:yolnDA2623@202.155.18.29:6379/0

JWT_SECRET=yolnDA2623*KingRovs771
TOKEN_HOUR_LIFESPAN=128

# --- Konfigurasi DB & Redis (VPS 2) ---
# Environment variabel di bawah ini digunakan untuk inisialisasi pada VPS 2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password_db_rahasia
POSTGRES_DB=skripsi_db

REDIS_PASSWORD=password_redis_rahasia
JWT_SECRET="secret"
TOKEN_HOUR_LIFESPAN=128

# --- Integrasi n8n (Fitur Laporan Bully) ---
# URL webhook n8n yang menerima POST ketika ada laporan bully baru
N8N_BULLY_WEBHOOK_URL=https://n8n.domain-anda.id/webhook/bully-report
# Shared secret untuk validasi di sisi n8n (header X-Webhook-Secret)
N8N_WEBHOOK_SECRET=shared_secret_rahasia_anda
# Base URL frontend (dipakai untuk membuat link_detail di payload webhook)
# Base URL frontend (dipakai untuk membuat link_detail di payload webhook)
APP_BASE_URL=https://domain-anda.id

# --- Variabel untuk Skrip Backup (backup_sindas.sh) ---
# Variabel ini digunakan oleh skrip bash agar bisa mengupdate status job ke DB
# Sesuaikan dengan kredensial database yang sama di atas
SINDAS_DB_HOST=202.155.18.29
SINDAS_DB_PORT=5432
SINDAS_DB_NAME=mentalhealth
SINDAS_DB_USER=postgres
SINDAS_DB_PASS=yolnDA2623*KingRovs771
BACKUP_SCRIPT_PATH=/opt/sindas/scripts/backup_sindas.sh